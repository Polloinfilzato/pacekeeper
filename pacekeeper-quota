#!/usr/bin/env bash
# pacekeeper-quota — read the quota numbers without getting them wrong.
#
# The status line writes ~/.claude/quota-state on every redraw. Reading that file by
# hand looks trivial and has two traps that do not show themselves until they cost you
# something. This exists so nobody has to remember them:
#
#   1. `week_days` IS NOT ALWAYS 7. Anthropic sometimes zeroes the weekly counter
#      without moving the weekly deadline — at a plan change, a billing renewal, or a
#      goodwill reset when a new model ships. The 100% you are holding then has to last
#      two days, not seven. A reader with 7 hardcoded computes a daily allowance three
#      times too generous, and errs on the side of letting you spend.
#
#   2. `ts` MUST BE COMPARED WITH THE CLOCK. The file can legitimately be old — nothing
#      writes it while every session is idle. A stale number read as current is the
#      exact failure this file is here to prevent.
#
# Both are handled below. Exit status: 0 the numbers are good, 2 there is nothing
# trustworthy to report (missing, incomplete, or stale). There is no exit status for
# "you have spent too much": what counts as too much is a policy, and a policy belongs
# to you, not to this. See examples/spend-guard.sh for one written out.
set -u

STATE="${PACEKEEPER_STATE:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/quota-state}"
MAX_AGE="${PACEKEEPER_MAX_AGE:-300}"
FORMAT="text"

for arg in "$@"; do
    case "$arg" in
        --json) FORMAT="json" ;;
        -h|--help)
            cat <<EOF
pacekeeper-quota — the quota numbers, already interpreted

  pacekeeper-quota           one human-readable line
  pacekeeper-quota --json    the same values as JSON

Environment:
  PACEKEEPER_STATE     path to quota-state (default: ~/.claude/quota-state)
  PACEKEEPER_MAX_AGE   seconds before the data counts as stale (default: 300)

Exit status: 0 = trustworthy numbers, 2 = nothing trustworthy to report.

Fields:
  day        which day of the window you are on
  days       how many days the remaining 100% actually has to cover — NOT always 7
  used_pct   percentage of the weekly window consumed
  balance    SIGNED: positive is still spendable today, negative is already borrowed
  age_s      how old the reading is
EOF
            exit 0 ;;
        *) printf 'unknown option: %s\n' "$arg" >&2; exit 2 ;;
    esac
done

# The reason text can contain a path, and a path can contain a quote or a backslash.
# Interpolating it straight into JSON produces something that is not JSON at all, which
# breaks the caller in a way that looks like our data rather than our formatting.
json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/ /g'
}

fail() {
    if [ "$FORMAT" = json ]; then
        printf '{"ok":false,"reason":"%s"}\n' "$(json_escape "$1")"
    else
        printf 'no trustworthy reading: %s\n' "$1"
    fi
    exit 2
}

[ -r "$STATE" ] || fail "$STATE is not readable"

# The file is plain KEY=value written by us, but it is still someone else's file on
# disk: read it by parsing, never by sourcing it into this shell.
day_idx=""; balance=""; over=""; week_used_pct=""; week_days=""; ts=""
while IFS='=' read -r key value; do
    case "$key" in
        day_idx)       day_idx=$value ;;
        balance)       balance=$value ;;
        over)          over=$value ;;
        week_used_pct) week_used_pct=$value ;;
        week_days)     week_days=$value ;;
        ts)            ts=$value ;;
    esac
done < "$STATE"

[ -n "$day_idx" ] && [ -n "$balance" ] && [ -n "$over" ] && [ -n "$ts" ] \
    || fail "the file is incomplete"

# EVERY FIELD IS VALIDATED BEFORE IT IS USED OR PRINTED. This program exists so nobody
# has to parse that file by hand, and a reader that passes `day_idx=wat` straight into
# an integer comparison, or interpolates `balance=--5` into its own JSON output, is not
# doing the job it was written for. A field that is not the shape it claims to be makes
# the whole reading untrustworthy: there is no partial credit here.
is_int()  { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }
# A lone "." contains nothing but a dot, so a digits-or-dot test waves it through - and
# it then reaches the JSON output as `"balance":.`, which is not JSON. The integer part
# has to be a number in its own right.
is_num()  {
    case "$1" in ''|*[!0-9.]*|*.*.*) return 1 ;; esac
    case "${1%%.*}" in ''|*[!0-9]*) return 1 ;; esac
    return 0
}

is_int "$day_idx"                  || fail "day_idx is not a whole number"
is_int "$ts"                       || fail "ts is not a whole number"
is_num "$balance"                  || fail "balance is not a number"
case "$over" in 0|1) : ;; *)          fail "over is neither 0 nor 1" ;; esac
[ -z "$week_used_pct" ] || is_num "$week_used_pct" || fail "week_used_pct is not a number"
is_int "$MAX_AGE"                  || fail "PACEKEEPER_MAX_AGE is not a whole number"

# Trap 1. ABSENT is fine and means 7: an older status line did not write this field, and
# a window that was never restarted really is seven days long. PRESENT BUT WRONG is not
# fine, and quietly turning it into 7 would be the exact failure this program exists to
# prevent - a made-up denominator is how a guard ends up three times too generous.
if [ -n "$week_days" ]; then
    is_int "$week_days" || fail "week_days is not a whole number"
    { [ "$week_days" -ge 1 ] && [ "$week_days" -le 7 ]; } || fail "week_days is outside 1..7"
else
    week_days=7
fi

# The day has to sit inside the window it claims to be part of. `day 0` and `day 99` both
# used to come through, and a guard comparing them against the last day then applies the
# wrong policy, or errors out mid-decision.
{ [ "$day_idx" -ge 1 ] && [ "$day_idx" -le "$week_days" ]; } \
    || fail "day_idx $day_idx is outside the window of $week_days day(s)"

# Trap 2.
now=$(date +%s)
age=$(( now - ts ))
# A reading from the future is not a fresh reading, it is a broken clock or a bad file.
# Clamping it to zero used to make it look like the freshest possible data.
if [ "$age" -lt 0 ]; then
    fail "the reading is dated in the future ($(( -age ))s ahead)"
fi
if [ "$age" -gt "$MAX_AGE" ]; then
    fail "the reading is ${age}s old (limit ${MAX_AGE}s) — no status line has run recently"
fi

# `balance` is stored unsigned with `over` carrying the sign. Handing that pair to a
# caller invites exactly one bug, so it leaves here already signed.
if [ "$over" = "1" ]; then
    signed="-$balance"
    verdict="over by ${balance}%"
else
    signed="$balance"
    verdict="still ${balance}% today"
fi

if [ "$FORMAT" = json ]; then
    printf '{"ok":true,"day":%s,"days":%s,"used_pct":%s,"balance":%s,"over":%s,"age_s":%s}\n' \
        "$day_idx" "$week_days" "${week_used_pct:-0}" "$signed" \
        "$( [ "$over" = "1" ] && printf 'true' || printf 'false' )" "$age"
else
    printf 'day %s/%s · %s%% of the week used · %s · read %ss ago\n' \
        "$day_idx" "$week_days" "${week_used_pct:-0}" "$verdict" "$age"
fi
